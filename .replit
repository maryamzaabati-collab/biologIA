run = "sh -c '(git fetch origin main && git reset --hard origin/main) || true; cd backend && npm install && node start.js'"
entrypoint = "backend/start.js"
modules = ["nodejs-22"]
hidden = [".config", "node_modules", "backend/node_modules"]

[nix]
channel = "stable-24_11"

[deployment]
run = ["sh", "-c", "git fetch origin main && git reset --hard origin/main && cd backend && npm install && node start.js"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 80
